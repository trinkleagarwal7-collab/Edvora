{
  "name": "edvora",
  "version": "1.0.0",
  "description": "Edvora — Personal AI-Powered MBA Learning Management System",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node server/src/index.js",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
    "build": "npm --prefix client run build",
    "vercel-build": "npm --prefix client run build",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "fast-xml-parser": "^4.5.0",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "uuid": "^10.0.0"
  },
  "keywords": [
    "mba",
    "lms",
    "ai",
    "rag",
    "product-management",
    "escape-room",
    "edvora"
  ],
  "author": "Antigravity",
  "license": "ISC"
}
